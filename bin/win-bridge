#!/usr/bin/env python3
"""Toasts and links on Windows from a WSL with interop off.

herdr's notifications arrive through the notify-send beside this. Windows reaches in, WSL never reaches out: a listener script on Windows
long-polls this server on localhost, which WSL forwards by default. Events go
in through a spool directory, never over the port, so a web page can't post
to it. Only a recent poll counts as someone listening.

Usage:
  win-bridge setup [host ...]      Turn it on; prints the command to run in Windows PowerShell
  win-bridge open <url>            Open a link in the Windows browser
  win-bridge toast <title> [body]  Show a toast; a click goes to its herdr workspace, and a button opens its first https link
  win-bridge status                Is Windows listening?
  win-bridge serve                 The server (its systemd unit runs this)
"""

import hmac
import json
import os
import re
import secrets
import shutil
import socket
import subprocess
import sys
import time
import tomllib
import zlib
import urllib.error
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import parse_qs, urlsplit

PORT = int(os.environ.get("WIN_BRIDGE_PORT", "47123"))
HOME = Path.home()
CONFIG = HOME / ".config/win-bridge"
STATE = HOME / ".local/state/win-bridge"
QUEUE = STATE / "queue"
SEEN = STATE / "seen"
UNIT = HOME / ".config/systemd/user/win-bridge.service"
LISTENER = Path(__file__).resolve().parent / "win-bridge-listener.ps1"
CLICK = Path(__file__).resolve().parent / "win-bridge-go.ps1"
# A scheduled task, as conhost --headless runs it with no window, where a Startup shortcut flashes one.
WINDOWS = """$d = "$env:LOCALAPPDATA\\win-bridge\\@NAME@"; $null = New-Item -ItemType Directory -Force $d
iwr -UseBasicParsing http://127.0.0.1:@PORT@/listener.ps1 -Headers @{'X-Token'='@TOKEN@'} -OutFile "$d\\listener.ps1"
$run = New-ScheduledTaskAction -Execute conhost.exe -Argument "--headless powershell.exe -NoProfile -ExecutionPolicy Bypass -File `"$d\\listener.ps1`""
$keep = New-ScheduledTaskSettingsSet -ExecutionTimeLimit (New-TimeSpan -Seconds 0) -RestartCount 999 -RestartInterval (New-TimeSpan -Minutes 1) -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries -MultipleInstances IgnoreNew
Register-ScheduledTask -TaskName win-bridge-@NAME@ -Action $run -Trigger (New-ScheduledTaskTrigger -AtLogOn -User $env:USERNAME) -Settings $keep -Force > $null
Start-ScheduledTask -TaskName win-bridge-@NAME@

To remove it: Unregister-ScheduledTask win-bridge-@NAME@ -Confirm:$false; Remove-Item -Recurse "$env:LOCALAPPDATA\\win-bridge\\@NAME@"; Remove-Item -Recurse HKCU:\\Software\\Classes\\win-bridge-@PORT@
"""
# WSL stops a distro a while after its last terminal closes, and the bridge with it. A hidden sleep keeps it up.
KEEP = """$run = New-ScheduledTaskAction -Execute conhost.exe -Argument "--headless wsl.exe -d @DISTRO@ --exec sleep infinity"
$keep = New-ScheduledTaskSettingsSet -ExecutionTimeLimit (New-TimeSpan -Seconds 0) -RestartCount 999 -RestartInterval (New-TimeSpan -Minutes 1) -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries -MultipleInstances IgnoreNew
Register-ScheduledTask -TaskName WSL-KeepAlive-@DISTRO@ -Action $run -Trigger (New-ScheduledTaskTrigger -AtLogOn -User $env:USERNAME) -Settings $keep -Force > $null
Start-ScheduledTask -TaskName WSL-KeepAlive-@DISTRO@

To remove it: Unregister-ScheduledTask WSL-KeepAlive-@DISTRO@ -Confirm:$false
"""
POLL = 25
LIVE = 60  # a poll ends every POLL seconds, so longer than that without one means nobody's there
STALE = {"open": 30, "toast": 600}  # a laptop waking up shouldn't open a burst of tabs
LINK = re.compile(r"https://\S+")
TITLE = "{hostname}: {workspace}"  # herdr's default ui.window_title
TAB = "herdr"  # what to name herdr's Windows Terminal tab, so a click finds it for sure
BOARD = "workshop"  # the workspace a click goes to when the toast's own one can't be told apart
PLACES: dict[str, str] = {}  # a shown toast's id to the workspace a click on it goes to


def token() -> str:
    return (CONFIG / "token").read_text().strip()


def listening() -> bool:
    try:
        return time.time() - SEEN.stat().st_mtime < LIVE
    except OSError:
        return False


def send(event: dict) -> bool:
    if not listening():
        return False
    put(event | {"at": time.time()})
    return True


def put(event: dict) -> None:
    QUEUE.mkdir(parents=True, exist_ok=True)
    name = f"{time.time_ns()}.json"
    (QUEUE / f".{name}").write_text(json.dumps(event))
    (QUEUE / f".{name}").rename(QUEUE / name)


def take() -> dict | None:
    for path in sorted(QUEUE.glob("*.json")):
        try:
            event = json.loads(path.read_text())
            path.unlink()
        except (OSError, ValueError):
            continue  # another poll took it first
        if time.time() - event.get("at", 0) < STALE.get(event.get("kind"), 0):
            return event
    return None


def where(title: str, body: str) -> str:
    """herdr's own toasts start the body with the workspace, and workshop's name the run's, whose workspace has its key."""
    if " · " in body:
        return body.split(" · ")[0]
    words = title.split()
    return words[1] if len(words) > 1 and words[0] == "Workshop:" else ""


def go(label: str) -> str:
    """Only to a workspace a toast named, so a click can't be made to run anything else. Says the titles herdr's tab may have, likeliest first."""
    if not label:
        return ""
    herdr = shutil.which("herdr", path=f"{HOME}/.local/bin:{os.environ.get('PATH', '')}") or "herdr"
    try:
        spaces = json.loads(subprocess.run([herdr, "workspace", "list"], capture_output=True, text=True, timeout=5).stdout)["result"]["workspaces"]
        found = [space["workspace_id"] for space in spaces if space.get("label") == label]
        found = found if len(found) == 1 else [space["workspace_id"] for space in spaces if space.get("label") == BOARD]
        if not found:
            return ""
        subprocess.run([herdr, "workspace", "focus", found[0]], capture_output=True, timeout=5)
        shown = next(space["label"] for space in spaces if space["workspace_id"] == found[0])
    except (OSError, ValueError, KeyError, StopIteration, subprocess.SubprocessError):
        return ""
    try:
        template = tomllib.loads(Path(os.environ.get("HERDR_CONFIG_PATH", HOME / ".config/herdr/config.toml")).read_text()).get("ui", {}).get("window_title", TITLE)
    except (OSError, ValueError):
        template = TITLE
    # Windows Terminal often names the tab itself: a tab named herdr is unmistakable, then the distro's is a guess.
    return "\n".join([template.replace("{hostname}", socket.gethostname()).replace("{workspace}", shown), TAB, *distro()])


def distro() -> list[str]:
    try:
        return [(CONFIG / "distro").read_text().strip()]
    except OSError:
        return []


class Handler(BaseHTTPRequestHandler):
    def do_GET(self) -> None:
        if not hmac.compare_digest(self.headers.get("X-Token", ""), token()):
            return self.reply(403)
        path = urlsplit(self.path).path
        if path == "/listener.ps1":
            return self.reply(200, LISTENER.read_text().replace("__PORT__", str(PORT)).replace("__TOKEN__", token()).replace("__HOSTS__", (CONFIG / "hosts").read_text().strip()).encode(), "text/plain")
        if path == "/go.ps1":
            return self.reply(200, CLICK.read_text().replace("__PORT__", str(PORT)).replace("__TOKEN__", token()).encode(), "text/plain")
        if path == "/focus":
            return self.reply(200, go(PLACES.get(parse_qs(urlsplit(self.path).query).get("id", [""])[0], "")).encode(), "text/plain")
        if path != "/next":
            return self.reply(404)
        QUEUE.mkdir(parents=True, exist_ok=True)
        until = time.time() + POLL
        while True:
            SEEN.touch()
            event = take()
            if event:
                if place := event.pop("where", ""):
                    event["focus"] = secrets.token_hex(8)
                    PLACES[event["focus"]] = place
                    while len(PLACES) > 200:
                        PLACES.pop(next(iter(PLACES)))
                try:
                    return self.reply(200, json.dumps(event).encode(), "application/json")
                except OSError:
                    # The poll had gone, as when the listener restarts, so the next one gets it.
                    put(event)
                    return
            if time.time() > until:
                return self.reply(204)
            time.sleep(0.5)

    def reply(self, code: int, body: bytes = b"", kind: str = "") -> None:
        self.send_response(code)
        if kind:
            self.send_header("Content-Type", kind)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, *_: object) -> None:
        pass


def hosts(asked: list[str]) -> list[str]:
    if asked:
        return asked
    found = ["github.com"]
    try:
        jira = tomllib.loads((HOME / ".config/workshop/config.toml").read_text()).get("jira", {}).get("base_url", "")
        found += [urlsplit(jira).hostname] if jira else []
    except (OSError, ValueError):
        pass
    return found


def herdr_toasts() -> str:
    try:
        return tomllib.loads(Path(os.environ.get("HERDR_CONFIG_PATH", HOME / ".config/herdr/config.toml")).read_text()).get("ui", {}).get("toast", {}).get("delivery", "")
    except (OSError, ValueError):
        return ""


def answer(port: int, tries: int = 1) -> int:
    """What holds the port answers our token with: 404 is our own bridge, 403 another distro's, 0 nothing."""
    req = urllib.request.Request(f"http://127.0.0.1:{port}/nope", headers={"X-Token": token()})
    for _ in range(tries):
        try:
            with urllib.request.urlopen(req, timeout=1) as reply:
                return reply.status
        except urllib.error.HTTPError as e:
            return e.code
        except OSError:
            time.sleep(0.1)
    return 0


def free(port: int) -> bool:
    try:
        with socket.socket() as s:
            s.bind(("127.0.0.1", port))
        return True
    except OSError:
        return False


def pick_port() -> int:
    """WIN_BRIDGE_PORT, else the port this distro already has, else a free one.

    All distros share one network, so each needs its own. The search starts at a
    spot hashed from the distro's name, so two distros, one of them stopped and
    so invisible, are unlikely to pick the same port.
    """
    if os.environ.get("WIN_BRIDGE_PORT"):
        return PORT
    try:
        mine = int(re.search(r"^Environment=WIN_BRIDGE_PORT=(\d+)$", UNIT.read_text(), re.M).group(1))
        if free(mine) or answer(mine) == 404:
            return mine
    except (OSError, AttributeError):
        pass
    start = zlib.crc32(os.environ.get("WSL_DISTRO_NAME", "").encode()) % 800
    for i in range(800):
        if free(port := 47200 + (start + i) % 800):
            return port
    raise SystemExit("No free port in 47200-47999 for win-bridge; set WIN_BRIDGE_PORT.")


def setup(asked: list[str]) -> int:
    global PORT
    CONFIG.mkdir(parents=True, exist_ok=True)
    if not (CONFIG / "token").exists():
        (CONFIG / "token").touch(mode=0o600)
        (CONFIG / "token").write_text(secrets.token_urlsafe(24))
    allowed = hosts(asked)
    PORT = pick_port()
    if os.environ.get("WSL_DISTRO_NAME"):
        (CONFIG / "distro").write_text(os.environ["WSL_DISTRO_NAME"])
    # Windows checks links against these before opening them, so nothing in WSL can make it open anything else.
    (CONFIG / "hosts").write_text(", ".join(f"'{h}'" for h in allowed if re.fullmatch(r"[A-Za-z0-9.-]+", h)))
    UNIT.parent.mkdir(parents=True, exist_ok=True)
    UNIT.write_text(f"[Unit]\nDescription=win-bridge: toasts and links on Windows\n\n[Service]\nEnvironment=WIN_BRIDGE_PORT={PORT}\nExecStart={Path(__file__).resolve()} serve\nRestart=on-failure\n\n[Install]\nWantedBy=default.target\n")
    subprocess.run(["systemctl", "--user", "daemon-reload"], check=True)
    subprocess.run(["systemctl", "--user", "enable", "--now", "win-bridge.service"], check=True)
    subprocess.run(["systemctl", "--user", "restart", "win-bridge.service"], check=True)
    # The last guard, for a WIN_BRIDGE_PORT someone set: another distro's bridge would take the listener's requests.
    if answer(PORT, tries=30) == 403:
        print(f"Port {PORT} is taken by another distro's win-bridge: all WSL distros share one network. Run setup again without WIN_BRIDGE_PORT and it picks a free one.")
        return 1
    print(f"On, port {PORT}. Links open on: {', '.join(allowed)}.")
    steps = [("In Windows PowerShell: links and toasts",
              "Paste this, no admin needed. It fetches the listener and runs it now and at every sign-in, with no window:\n\n" + WINDOWS.replace("@NAME@", os.environ.get("WSL_DISTRO_NAME") or f"port-{PORT}").replace("@PORT@", str(PORT)).replace("@TOKEN@", token()))]
    if name := os.environ.get("WSL_DISTRO_NAME", ""):
        steps.append((f"In Windows PowerShell: keep {name} running",
                      "So toasts and workshop's timers don't stop when you close your terminals, paste this too:\n\n" + KEEP.replace("@DISTRO@", name)))
    if herdr_toasts() != "system":
        steps.append(("In WSL: herdr's notifications",
                      'herdr\'s own notifications, and workshop\'s, which go through herdr, reach Windows once ~/.config/herdr/config.toml has this, above the herdr-workbench block, then run herdr server reload-config:\n\n[ui.toast]\ndelivery = "system"\n'))
    for n, (title, body) in enumerate(steps, 1):
        print(f"\n── {n} of {len(steps)} · {title} " + "─" * max(4, 60 - len(title)) + f"\n\n{body}")
    return 0


def main(argv: list[str]) -> int:
    match argv:
        case ["serve"]:
            ThreadingHTTPServer(("127.0.0.1", PORT), Handler).serve_forever()
        case ["setup", *asked]:
            return setup(asked)
        case ["open", url] if url.startswith("https://"):
            return 0 if send({"kind": "open", "url": url}) else 1
        case ["toast", title, *body]:
            text = " ".join(body)
            found = LINK.search(text)
            send({"kind": "toast", "title": title, "body": text, "url": found.group(0) if found else "", "where": where(title, text)})
        case ["status"]:
            print("Windows is listening." if listening() else "Windows isn't listening. win-bridge setup shows how to start it.")
            return 0 if listening() else 1
        case _:
            print(__doc__, file=sys.stderr)
            return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
