#!/usr/bin/env bash
# System Python: it has python3-yaml, and needs no venv or mise activation.
# Cron and herdr events start with a bare PATH, and our tools live in these two.
export PYTHONDONTWRITEBYTECODE=1
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"
root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
PYTHONPATH="$root" exec /usr/bin/python3 -m workshop "$@"
